# Database
DATABASE_URL=postgresql+asyncpg://delegato:delegato@postgres:5432/delegato

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET_KEY=change-me-to-random-secret
JWT_REFRESH_SECRET_KEY=change-me-to-another-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Email (Unisender Go)
UNISENDER_API_KEY=your-unisender-go-api-key
UNISENDER_FROM_EMAIL=noreply@delegato.ru
UNISENDER_FROM_NAME=Delegato

# Payment Provider (tbank or yookassa)
PAYMENT_PROVIDER=tbank
PAYMENT_SECRET_KEY=your-payment-secret
PAYMENT_TERMINAL_KEY=your-terminal-key
PAYMENT_WEBHOOK_IPS=

# Claude API
CLAUDE_API_KEY=your-claude-api-key

# Sentry
SENTRY_DSN=

# Admin
ADMIN_WHITELIST_IPS=127.0.0.1

# CORS
CORS_ORIGINS=http://localhost:3000

# Infrastructure (Terraform + Ansible)
TIMEWEB_API_TOKEN=your-timeweb-api-token
TIMEWEB_AVAILABILITY_ZONE=ams-1
TIMEWEB_SSH_KEY_ID=352731
TIMEWEB_PRESET_CPU=2
TIMEWEB_PRESET_RAM=4096
TERRAFORM_STATE_BUCKET=delegato-tfstate
TERRAFORM_STATE_ENDPOINT=https://s3.twcstorage.ru
TERRAFORM_STATE_ACCESS_KEY=your-s3-access-key
TERRAFORM_STATE_SECRET_KEY=your-s3-secret-key
SSH_PRIVATE_KEY_PATH=~/.ssh/delegata_rsa
INFRASTRUCTURE_DIR=infrastructure
OPENCLAW_DOCKER_IMAGE=ghcr.io/openclaw/openclaw:latest

# App
APP_VERSION=1.0.0
DEBUG=true
